{
	"i18n": true,
	"type": "panel",
	"items": {
		"username": {
			"type": "text",
			"label": "MELCloud Home username (email)",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"password": {
			"type": "password",
			"label": "MELCloud Home password",
