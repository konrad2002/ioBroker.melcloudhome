# No dot-directories except github/vscode
.*/
!.vscode/
!.github/

*.code-workspace
node_modules
nbproject

# npm package files
iobroker.*.tgz

Thumbs.db
.commitinfo

# i18n intermediate files
admin/i18n/flat.txt
admin/i18n/*/flat.txt

# NOTE: build/ is intentionally committed (not ignored). Installing this adapter directly
# from GitHub (rather than a published npm package) does not run any build step, so the
# compiled build/ output must be checked in and kept up to date, or the adapter fails at
# startup with "Cannot find module './lib/melcloud/...'".
